{
  "name": "revoq-offchain",
  "version": "0.1.0",
  "private": true,
  "description": "TDK reference implementation: credential query language, three-accumulator registry, atomic guarded updates",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:classify": "node eval/classify-exhaustive.ts",
    "eval:bench": "node eval/bench.ts",
    "demo": "node eval/flat-reservation.ts",
    "eval:gas": "node eval/gas.ts",
    "eval:report": "node eval/report.ts",
    "demo:op-sepolia": "node eval/op-sepolia.ts",
    "bdd": "cucumber-js",
    "bdd:op-sepolia": "TARGET=op-sepolia cucumber-js"
  },
  "dependencies": {
    "@digitalbazaar/bbs-signatures": "3.1.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "24.3.0",
    "solc": "0.8.30",
    "typescript": "5.9.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
